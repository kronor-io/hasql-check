cabal-version: 3.0
name:          hasql-check-hie
version:       0.5.0.0
synopsis:
  Extract the types of inferred hasql statements from .hie files

description:
  Reads the .hie files GHC writes with -fwrite-ide-info and prints, for every
  quote of Hasql.Check.Inferred.TH, the Haskell types its statement is used
  at, for hasql-check --inferred to check against a database. It needs no
  database, so it can run inside a sandboxed build. Build it with the GHC the
  checked project is built with: the .hie format changes between releases.

category:      Database, Development
homepage:      https://github.com/kronor-io/hasql-check
bug-reports:   https://github.com/kronor-io/hasql-check/issues
license:       BSD-3-Clause
license-file:  LICENSE
author:        Kronor
maintainer:    lorenzo@kronor.io
copyright:     2026 Kronor
build-type:    Simple

source-repository head
  type:     git
  location: https://github.com/kronor-io/hasql-check
  subdir:   hie

flag lint
  description: lint
  manual:      True
  default:     False

executable hasql-check-hie
  main-is:            Main.hs
  hs-source-dirs:     app
  default-language:   GHC2021
  default-extensions: LambdaCase
  ghc-options:
    -Wall -Wcompat -Widentities -Wincomplete-record-updates
    -Wincomplete-uni-patterns -Wpartial-fields -Wredundant-constraints

  if flag(lint)
    ghc-options: -Werror

  build-depends:
    , base        >=4.11 && <10
    , bytestring
    , containers
    , ghc         >=9.12 && <9.13
    , text
